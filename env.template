# OpenAI API Key (必需 - 如果使用OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI 配置 (必需 - 如果使用Azure OpenAI)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# 选择使用的AI服务 (openai 或 azure)
AI_SERVICE_PROVIDER=azure

# LangSmith 配置 (可选，但推荐用于开发)
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_CALLBACKS_BACKGROUND=true
LANGCHAIN_TRACING_V2=true

# GitHub Personal Access Token (必需)
GITHUB_TOKEN=your_github_token_here

# Geocode API Key (可选 - 如果使用真实天气数据)
GEOCODE_API_KEY=your_geocode_api_key_here

# 天气工具测试模式 (true=使用测试数据, false=使用真实API)
WEATHER_TEST_MODE=true
